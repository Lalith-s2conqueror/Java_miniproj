<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===== Project Coordinates ===== -->
    <groupId>com.campusportal</groupId>
    <artifactId>campus-complaint-portal</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Campus Complaint Portal</name>
    <description>
        A Java Servlet/JSP web application that enables students to submit campus
        complaints and allows administrators to track, update, and resolve them.
        Academic mini-project - Second-Year Engineering.
    </description>

    <!-- ===== Global Properties ===== -->
    <properties>
        <!-- Source and bytecode compatibility target -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency versions - centralised here so they are easy to update -->
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <mysql.connector.version>8.4.0</mysql.connector.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <mockito.version>5.11.0</mockito.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.war.plugin.version>3.4.0</maven.war.plugin.version>
    </properties>

    <!-- ===== Dependencies ===== -->
    <dependencies>

        <!--
            Jakarta Servlet API 6.0
            Scope "provided": the servlet container (Tomcat 10+) already
            ships this jar at runtime, so we must NOT bundle it in the WAR.
            Jakarta EE 10 / Tomcat 10.1 uses the jakarta.* package namespace.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            MySQL Connector/J
            Scope "runtime": needed at runtime by the server, but we do not
            compile against it directly (we use java.sql.* interfaces).
            The driver will be bundled inside the WAR under WEB-INF/lib.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            JUnit Jupiter (JUnit 5)
            Scope "test": only used during the test phase; not packaged in WAR.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            jBCrypt 0.4
            Provides BCrypt password hashing for secure credential storage.
            Scope "compile": must be bundled in the WAR (no container equivalent).
        -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!--
            Mockito Core
            Mocking framework for unit tests of DAO and service classes.
            Scope "test": not included in the WAR.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===== Build Plugins ===== -->
    <build>
        <!-- The final WAR file name (without version suffix) -->
        <finalName>campus-complaint-portal</finalName>

        <plugins>

            <!--
                Maven Compiler Plugin
                Explicitly configured to use Java 17 source/target via
                the release element (equivalent to the release flag at javac).
                Note: The installed JDK is 25 which is newer than 17.
                Maven will compile bytecode targeting Java 17 class-file
                format, so the WAR can be deployed on a Java 17+ server.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!--
                Maven WAR Plugin
                Produces the .war archive from src/main/webapp.
                failOnMissingWebXml=false allows builds when web.xml is
                optional (Servlet 3.0+), but we supply one explicitly for
                clarity and compatibility.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven.war.plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
